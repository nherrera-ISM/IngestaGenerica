{
	"name": "DS_DestinoParquet",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_DataLake",
			"type": "LinkedServiceReference",
			"parameters": {
				"NombreSecreto": {
					"value": "@dataset().NombreSecretoCtaAlmacenamiento",
					"type": "Expression"
				},
				"NombreCuentaAlmacenamiento": {
					"value": "@dataset().NombreCuentaAlmacenamiento",
					"type": "Expression"
				}
			}
		},
		"parameters": {
			"DirectorioRaizDataLake": {
				"type": "string",
				"defaultValue": "empresa/dominio/sistema_fuente/zona"
			},
			"NombreArchivo": {
				"type": "string",
				"defaultValue": "Archivo"
			},
			"ContenedorDataLake": {
				"type": "string",
				"defaultValue": "landing"
			},
			"NombreCuentaAlmacenamiento": {
				"type": "string",
				"defaultValue": "dlaeuhcldevdatadriven"
			},
			"NombreSecretoCtaAlmacenamiento": {
				"type": "string",
				"defaultValue": "dlaeuhcldevdatadrivenkey"
			}
		},
		"folder": {
			"name": "IngestaGenerica"
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().NombreArchivo,'.parquet')",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().DirectorioRaizDataLake",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().ContenedorDataLake",
					"type": "Expression"
				}
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}