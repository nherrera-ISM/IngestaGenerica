							"linkedServiceName": {
								"referenceName": "LS_SQLMetaData",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Preparar Cada Ingesta Silver",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "CargarConfiguracionAtributos",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "  SELECT DISTINCT Proyecto, Tema, NombreIngesta, DirectorioDestino FROM [Metadata].[IngestaSilverConfiguracionAtributo]\n    WHERE Proyecto =  '@{pipeline().parameters.Proyecto}' \n  and Tema = CASE WHEN  '@{pipeline().parameters.Tema}' = '*' THEN Tema ELSE '@{pipeline().parameters.Tema}' END \n  and NombreIngesta = CASE WHEN  '@{pipeline().parameters.NombreIngesta}' = '*' THEN NombreIngesta ELSE '@{pipeline().parameters.NombreIngesta}' END \n  and Tema <> 'MovimientoCapas'\n  and RequeridoSilver = 'Si'\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_OrigenSQLMetaDatos",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
