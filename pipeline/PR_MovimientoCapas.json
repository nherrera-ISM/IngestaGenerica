									},
									"DirectorioOrigen": {
										"value": {
											"value": "@activity('Generar consulta').output.firstRow.DirectorioOrigen",
											"type": "Expression"
										},
										"type": "String"
									},
									"DirectorioDestino": {
										"value": {
											"value": "@activity('Generar consulta').output.firstRow.DirectorioDestino",
											"type": "Expression"
										},
										"type": "String"
									}
								}
