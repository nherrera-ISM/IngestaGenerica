			{
				"name": "Obtener credenciales conexion y metadata MFD",
				"description": "Validar hoja extracciones y nombre de hoja BronzeSilver\n\nEste look up retorna \nNombreSecretoCtaDataLake\nNombreCuentaAlmacenamientoDataLake\nDirectorioDestino_Ontologia\nNombreArchivoDestino",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "WITH ParametrosPivotados AS (\n    SELECT *\n    FROM (\n        SELECT CodigoParametro, Valor \n        FROM Metadata.Parametros\n        WHERE Proyecto = 'Transversal'\n    ) AS SourceTable\n    PIVOT (\n        MAX(Valor) \n        FOR CodigoParametro IN ([NombreSecretoCtaDataLake], [NombreCuentaAlmacenamientoDataLake])\n    ) AS PivotTable\n)\n\nSELECT PP.NombreSecretoCtaDataLake, PP.NombreCuentaAlmacenamientoDataLake,\n       IC.DirectorioDestino_Ontologia, concat(IC.NombreArchivoDestino,'.parquet') AS NombreArchivoDestino\nFROM ParametrosPivotados PP\nJOIN [Metadata].[IngestaConfiguracion] IC\nON 1=1  -- Esto garantiza que todas las filas de una tabla se unan con todas las filas de la otra\nWHERE IC.Proyecto = '@{pipeline().parameters.Proyecto}' AND IC.Tema = 'MovimientoCapas' AND IC.NombreExtraccion = 'BronzeSilver';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_OrigenSQLMetaDatos",
						"type": "DatasetReference"
					}
				}
			},
